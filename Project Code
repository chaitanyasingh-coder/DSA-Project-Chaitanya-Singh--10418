        System.out.print("Enter amount to search: ");
        String amountText = scanner.nextLine().trim();
        double target;
        try {
            target = Double.parseDouble(amountText);
        } catch (NumberFormatException ex) {
            System.out.println("Invalid amount. Amount must be greater than 0.");
            return;
        }

        Expense[] expenses = list.toArray();
        int foundIndex = binarySearch(expenses, target);
        if (foundIndex < 0) {
            System.out.println("Amount " + Expense.formatAmount(target) + " not found.");
            return;
        }

        int first = foundIndex;
        while (first > 0 && Double.compare(expenses[first - 1].getAmount(), target) == 0) first--;
        int last = foundIndex;
        while (last + 1 < expenses.length &&
               Double.compare(expenses[last + 1].getAmount(), target) == 0) last++;
        for (int i = first; i <= last; i++) {
            System.out.println("Found: " + expenses[i]);
        }
    }

