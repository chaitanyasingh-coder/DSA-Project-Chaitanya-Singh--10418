class Expense {
    private final String id;
    private final String category;
    private final double amount;

    Expense(String id, String category, double amount) {
        this.id = id;
        this.category = category;
        this.amount = amount;
    }

    String getId() { return id; }
    String getCategory() { return category; }
    double getAmount() { return amount; }

    @Override
    public String toString() {
        return id + " | " + category + " | " + formatAmount(amount);
    }

    static String formatAmount(double amount) {
        if (Math.abs(amount - Math.rint(amount)) < 0.0000001) {
            return String.valueOf((long) Math.rint(amount));
        }
        return String.format(Locale.US, "%.2f", amount);
    }
}

class Node {
    Expense data;
    Node next;

    Node(Expense data) {
        this.data = data;
        this.next = null;
    }
}

class ExpenseList {
    private Node head;
    private Node tail;
    private int size;

    public void add(Expense expense) {
        Node node = new Node(expense);
        if (head == null) {
            head = tail = node;
        } else {
            tail.next = node;
            tail = node;
        }
        size++;
    }

    public boolean removeById(String id) {
        Node current = head;
        Node previous = null;
        while (current != null) {
            if (current.data.getId().equals(id)) {
                if (previous == null) {
                    head = current.next;
                } else {
                    previous.next = current.next;
                }
                if (current == tail) {
                    tail = previous;
                }
                size--;
                if (head == null) tail = null;
                return true;
            }
            previous = current;
            current = current.next;
        }
        return false;
    }

    public void sortByAmount() {
        head = mergeSort(head);
        tail = head;
        if (tail != null) {
            while (tail.next != null) tail = tail.next;
        }
    }

    private Node mergeSort(Node node) {
        if (node == null || node.next == null) return node;
        Node middle = getMiddle(node);
        Node right = middle.next;
        middle.next = null;
        Node leftSorted = mergeSort(node);
        Node rightSorted = mergeSort(right);
        return merge(leftSorted, rightSorted);
    }

    private Node getMiddle(Node node) {
        Node slow = node;
        Node fast = node.next;
        while (fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow;
    }

    private Node merge(Node left, Node right) {
        Node dummy = new Node(null);
        Node current = dummy;
        while (left != null && right != null) {
            if (left.data.getAmount() <= right.data.getAmount()) {
                current.next = left;
                left = left.next;
            } else {
                current.next = right;
                right = right.next;
            }
            current = current.next;
        }
        current.next = (left != null) ? left : right;
        return dummy.next;
    }

    public boolean isSortedByAmount() {
        if (head == null) return true;
        Node current = head;
        while (current.next != null) {
            if (current.data.getAmount() > current.next.data.getAmount()) return false;
            current = current.next;
        }
        return true;
    }

    public Expense[] toArray() {
        Expense[] result = new Expense[size];
        Node current = head;
        int index = 0;
        while (current != null) {
            result[index++] = current.data;
            current = current.next;
        }
        return result;
    }

    public void printAll() {
        if (head == null) {
            System.out.println("No expenses recorded.");
            return;
        }
        Node current = head;
        int index = 1;
        while (current != null) {
            System.out.println(index++ + ". " + current.data);
            current = current.next;
        }
        System.out.println("Total expenses: " + size);
    }

    public int size() { return size; }
}

